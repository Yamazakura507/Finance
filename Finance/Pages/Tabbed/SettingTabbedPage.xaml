<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:setingPage="clr-namespace:Finance.Pages.WorkPage.Setting"
             x:Class="Finance.Pages.Tabbed.SettingTabbedPage"
             UnselectedTabColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource TabDark}}"
            SelectedTabColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource TabDark}}"
            BarTextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource TabDark}}" Loaded="TabbedPage_Loaded">
            <setingPage:SettingsPage Title="Настройки" IconImageSource="settings.png" BindingContext="{Binding}"/>
            <setingPage:AddressPage Title="Адреса" IconImageSource="address.png" BindingContext="{Binding}"/>
            <setingPage:ColorsPage Title="Цвета" IconImageSource="colors.png" BindingContext="{Binding}"/>
</TabbedPage>